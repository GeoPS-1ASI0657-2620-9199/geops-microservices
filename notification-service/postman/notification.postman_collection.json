{
  "info": {
    "name": "GeoPS Notification",
    "description": "Notification service requests. baseUrl is the service port; point it to the gateway to go through nginx. The login request fills token from Identity. With the demo profile, user 1 has a recipient copy. The location requests stamp the capture time before they are sent.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Identity",
      "item": [
        {
          "name": "Log in as consumer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{identityUrl}}/api/v1/auth/login",
              "host": [
                "{{identityUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{consumerEmail}}\",\n  \"password\": \"{{consumerPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.collectionVariables.set(\"token\", pm.response.json().accessToken);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "US48 Preferences",
      "item": [
        {
          "name": "Set email on, push off and a daily limit of 3",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/notification-preferences",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "notification-preferences"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pushEnabled\": false,\n  \"emailEnabled\": true,\n  \"dailyLimit\": 3\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"dailyLimit is 3\", function () {",
                  "    pm.expect(pm.response.json().dailyLimit).to.eql(3);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Set a daily limit of 0",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/notification-preferences",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "notification-preferences"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pushEnabled\": true,\n  \"emailEnabled\": true,\n  \"dailyLimit\": 0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 400\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "pm.test(\"code is INVALID_REQUEST\", function () {",
                  "    pm.expect(pm.response.json().code).to.eql(\"INVALID_REQUEST\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Set preferences without token",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/notification-preferences",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "notification-preferences"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pushEnabled\": false,\n  \"emailEnabled\": true,\n  \"dailyLimit\": 3\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 401\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "pm.test(\"code is UNAUTHORIZED\", function () {",
                  "    pm.expect(pm.response.json().code).to.eql(\"UNAUTHORIZED\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "US29 Last known location",
      "item": [
        {
          "name": "Record location captured now",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/locations/last",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "locations",
                "last"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"latitude\": -12.1211,\n  \"longitude\": -77.0297,\n  \"accuracyMeters\": 25,\n  \"capturedAt\": \"{{capturedAt}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"capturedAt\", new Date().toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"fresh is True\", function () {",
                  "    pm.expect(pm.response.json().fresh).to.eql(true);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Record location captured in the future",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/locations/last",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "locations",
                "last"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"latitude\": -12.1211,\n  \"longitude\": -77.0297,\n  \"accuracyMeters\": 25,\n  \"capturedAt\": \"{{futureCapturedAt}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"futureCapturedAt\", new Date(Date.now() + 10 * 60 * 1000).toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 400\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "pm.test(\"code is INVALID_CAPTURE_TIME\", function () {",
                  "    pm.expect(pm.response.json().code).to.eql(\"INVALID_CAPTURE_TIME\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Record location with latitude out of range",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/locations/last",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "locations",
                "last"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"latitude\": 95,\n  \"longitude\": -77.0297,\n  \"accuracyMeters\": 25,\n  \"capturedAt\": \"{{capturedAt}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"capturedAt\", new Date().toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 400\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "pm.test(\"code is INVALID_REQUEST\", function () {",
                  "    pm.expect(pm.response.json().code).to.eql(\"INVALID_REQUEST\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8085"
    },
    {
      "key": "identityUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "consumerEmail",
      "value": "lucia.fernandez@ejemplo.pe"
    },
    {
      "key": "consumerPassword",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "capturedAt",
      "value": ""
    },
    {
      "key": "futureCapturedAt",
      "value": ""
    }
  ]
}
