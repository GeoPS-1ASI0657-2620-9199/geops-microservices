    {
      "name": "Nearby",
      "item": [
        {
          "name": "Search nearby offers",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/offers/nearby?lat=-12.0697&lng=-77.0240&radiusMinutes=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "offers",
                "nearby"
              ],
              "query": [
                {
                  "key": "lat",
                  "value": "-12.0697"
                },
                {
                  "key": "lng",
                  "value": "-77.0240"
                },
                {
                  "key": "radiusMinutes",
                  "value": "10"
                }
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"the seed offer is about 300 m away\", function () {",
                  "    const first = pm.response.json().content[0];",
                  "    pm.expect(first.title).to.eql(\"Menú ejecutivo a mitad de precio\");",
                  "    pm.expect(first.distanceMeters).to.be.within(290, 310);",
                  "    pm.expect(first.walkMinutes).to.eql(4);",
                  "});"
                ]
              }
            }
          ]
        },
