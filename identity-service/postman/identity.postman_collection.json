{
  "info": {
    "name": "GeoPS Identity",
    "description": "Identity service requests. baseUrl points to the gateway; use http://localhost:8081 to call the service directly.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "US20",
      "item": [
        {
          "name": "Register consumer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"role is CONSUMER\", function () {",
                  "    pm.expect(pm.response.json().role).to.eql(\"CONSUMER\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"CONSUMER\",\n  \"fullName\": \"Lucía Fernández Ríos\",\n  \"email\": \"lucia.fernandez@ejemplo.pe\",\n  \"phone\": \"987123456\",\n  \"password\": \"Ofertas#2026\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Register consumer with repeated email",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 409\", function () {",
                  "    pm.response.to.have.status(409);",
                  "});",
                  "pm.test(\"code is EMAIL_ALREADY_REGISTERED\", function () {",
                  "    pm.expect(pm.response.json().code).to.eql(\"EMAIL_ALREADY_REGISTERED\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"CONSUMER\",\n  \"fullName\": \"Mario Salas Paz\",\n  \"email\": \"lucia.fernandez@ejemplo.pe\",\n  \"phone\": \"987000111\",\n  \"password\": \"Ofertas#2026\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Register consumer with invalid data",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 400\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "pm.test(\"code is INVALID_REQUEST\", function () {",
                  "    pm.expect(pm.response.json().code).to.eql(\"INVALID_REQUEST\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"CONSUMER\",\n  \"fullName\": \"Lucía Fernández Ríos\",\n  \"email\": \"mario.salas@ejemplo.pe\",\n  \"phone\": \"12345\",\n  \"password\": \"corta\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ]
}
