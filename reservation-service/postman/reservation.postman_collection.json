    {
      "name": "US40",
      "item": [
        {
          "name": "Create reservation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/reservations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "reservations"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"offerId\": {{offerId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201, or 200 when it already existed\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "pm.test(\"code has 8 characters\", function () {",
                  "    pm.expect(pm.response.json().code).to.have.lengthOf(8);",
                  "});",
                  "pm.collectionVariables.set(\"reservationId\", pm.response.json().reservationId);",
                  "pm.collectionVariables.set(\"reservationCode\", pm.response.json().code);"
                ]
              }
            }
          ]
        },
