    {
      "name": "US41",
      "description": "Redeem at the store. Run \"Create reservation\" first so reservationCode holds an ACTIVE reservation of the business in businessToken.",
      "item": [
        {
          "name": "Redeem reservation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/reservations/redeem",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "reservations",
                "redeem"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{businessToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"{{reservationCode}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"status is REDEEMED with its date\", function () {",
                  "    pm.expect(pm.response.json().status).to.eql(\"REDEEMED\");",
                  "    pm.expect(pm.response.json().redeemedAt).to.be.a(\"string\");",
                  "});",
                  "pm.collectionVariables.set(\"redeemedAt\", pm.response.json().redeemedAt);"
                ]
              }
            }
          ]
        },
        {
          "name": "Redeem the same code again",
