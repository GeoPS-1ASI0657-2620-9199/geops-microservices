                  "pm.test(\"status is 409\", function () {",
                  "    pm.response.to.have.status(409);",
                  "});",
                  "pm.test(\"code is RESERVATION_ALREADY_REDEEMED\", function () {",
                  "    pm.expect(pm.response.json().code).to.eql(\"RESERVATION_ALREADY_REDEEMED\");",
                  "});",
                  "pm.test(\"redeemedAt is the date of the first redemption\", function () {",
                  "    pm.expect(pm.response.json().redeemedAt).to.eql(pm.collectionVariables.get(\"redeemedAt\"));",
                  "});"
                ]
              }
            }
